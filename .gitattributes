# Normalize line endings on checkout/commit (Windows + Linux contributors)
* text=auto

# Go sources, shell scripts and workflows must stay LF everywhere:
# gofmt rejects CRLF, which is what `text=auto` alone would check out
# on Windows and break the CI fmt job there.
*.go text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
# Overlay files land on a Linux target (ash chokes on CRLF), and these
# init/uci-defaults scripts have no .sh extension to match above.
firmware/files/** text eol=lf
