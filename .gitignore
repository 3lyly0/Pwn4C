# Built binaries (anchored: never match the cmd/pwn4c source dir itself)
/pwn4c.exe
/pwn4c
cmd/pwn4c/pwn4c
cmd/pwn4c/pwn4c.exe

# Local engineering notes / audit docs (not part of the public repo)
/pwn4c_architecture_audit_report.md
/pwn4c_project_todo_roadmap.md

# Stock / generated firmware images (large, downloadable from Xiaomi)
firmware/*.bin

# ImageBuilder scratch tree (large, re-downloadable)
firmware/.ib-work/

# Baked-in daemon binary + init script (CI build outputs, not sources)
firmware/files/usr/sbin/
firmware/files/etc/init.d/pwn4cd
# rc.d symlinks generated by firmware/build.sh
firmware/files/etc/rc.d/

# Exploit payload artifacts (rebuilt on every infect run)
*.tar.gz
*.tar.bz2
build/
output/

# Runtime captures / logs
*.pcap
*.log

# Go
/vendor/

# Python
__pycache__/
*.pyc

# Local-only helper scripts (kept out of the published repo)
/tools/*.py

# C build artifacts (daemon)
/daemon/*.o
/daemon/pwn4cd
/daemon/pwn4cd-mips
/daemon/tests/run_tests

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
