#!/bin/sh
# First-boot customization for the Pwn4C drone (applied by OpenWrt uci-defaults).
# This script runs exactly once on first boot, then is deleted by the framework.
#
# The actual settings live in /usr/lib/pwn4c/provision.sh so that the boot-time
# repair script (/etc/init.d/pwn4c-net) can re-apply exactly the same config if
# the first-boot overlay migration did not survive a reboot.
#
# See docs/troubleshooting.md ("failed to sync jffs2 overlay").

. /usr/lib/pwn4c/provision.sh
