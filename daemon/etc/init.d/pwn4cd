#!/bin/sh /etc/rc.common
# /etc/init.d/pwn4cd
# procd-supervised init script for the pwn4cd drone daemon.
#
# START=95 — after pwn4c-radio (START=21) which ensures radio is DOWN,
#            and after network (START=20) and any wpad if present.
# STOP=10  — stop early so radio is restored before network teardown.
#
# Install path (firmware overlay convention):
#   firmware/files/etc/init.d/pwn4cd
# This file is placed at /etc/init.d/pwn4cd on the rootfs.
# Enable it via:
#   /etc/init.d/pwn4cd enable
#
# Optional UCI options:
#   uci set pwn4cd.daemon.iface=wlan0
#   uci set pwn4cd.daemon.eth=eth0
#   uci set pwn4cd.daemon.psk_file=/etc/pwn4c.key
#   uci set pwn4cd.daemon.idle_timeout=0

START=95
STOP=10
USE_PROCD=1

DAEMON=/usr/sbin/pwn4cd
PIDFILE=/var/run/pwn4cd.pid

IFACE=$(uci -q get pwn4cd.daemon.iface 2>/dev/null || echo "wlan0")
ETH=$(uci  -q get pwn4cd.daemon.eth   2>/dev/null || echo "eth0")
PSK_FILE=$(uci -q get pwn4cd.daemon.psk_file 2>/dev/null || echo "/etc/pwn4c.key")
IDLE_TIMEOUT=$(uci -q get pwn4cd.daemon.idle_timeout 2>/dev/null || echo "0")

start_service() {
    # Validate the daemon binary exists
    [ -x "$DAEMON" ] || {
        logger -t pwn4cd "daemon binary not found at $DAEMON"
        return 1
    }

    logger -t pwn4cd "starting pwn4cd (iface=$IFACE eth=$ETH psk_file=$PSK_FILE idle_timeout=$IDLE_TIMEOUT)"

    procd_open_instance
    procd_set_param command "$DAEMON" --iface "$IFACE" --eth "$ETH" \
        --psk-file "$PSK_FILE" --idle-timeout "$IDLE_TIMEOUT"
    procd_set_param respawn 3600 5 0   # threshold=1h, timeout=5s, max_fail=0 (always)
    procd_set_param stdout 1           # capture stdout to syslog
    procd_set_param stderr 1           # capture stderr to syslog
    procd_set_param pidfile "$PIDFILE"
    procd_close_instance
}

stop_service() {
    logger -t pwn4cd "stopping pwn4cd"
    # procd handles SIGTERM; daemon cleans up radio on SIGTERM.
}

reload_service() {
    # Explicit `reload` (operator action) restarts the daemon. Config-change
    # triggers are deliberately not registered — see the note at the bottom.
    restart
}

# NOTE: intentionally no `procd_add_reload_trigger "network"`.
#
# WIFI_CONNECT and WIFI_DISCONNECT edit /etc/config/network (the wan proto and
# device) by design. A reload trigger on "network" made procd restart pwn4cd
# in the middle of those commands: the CLI's control socket was reset, the
# monitor session (if any) was torn down, and re-running the command produced
# the same restart again. The daemon re-reads interface state on demand and
# has its own ENETDOWN self-healing, so a network config change must not
# restart it.
